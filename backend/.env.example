# Geo-Intelligent Smart Token System - Backend Environment Config
PROJECT_NAME="GeoToken API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Host & Ports
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Database Configuration
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
# Default fallback for standalone dev/testing: sqlite:///./geotoken.db
DATABASE_URL="sqlite:///./geotoken.db"
# DATABASE_URL="mysql+pymysql://root:password@localhost:3306/geotoken"

# Security & JWT
SECRET_KEY="geotoken-super-secret-production-grade-jwt-key-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Geofencing & Queue Rules
DEFAULT_GEOFENCE_RADIUS_METERS=500
DEFAULT_TOKEN_VALIDITY_MINUTES=45
TOKEN_EXPIRATION_CHECK_INTERVAL_SECONDS=60

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
