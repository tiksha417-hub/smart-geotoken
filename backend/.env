PROJECT_NAME="GeoToken API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite default for out-of-the-box local testing, switchable to MySQL)
DATABASE_URL="sqlite:///./geotoken.db"

SECRET_KEY="geotoken-super-secret-production-grade-jwt-key-change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DEFAULT_GEOFENCE_RADIUS_METERS=500
DEFAULT_TOKEN_VALIDITY_MINUTES=45
TOKEN_EXPIRATION_CHECK_INTERVAL_SECONDS=60

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "*"]
